# Copy this file to .env and fill in your key
GROQ_API_KEY=your-groq-api-key-here

# Model config
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Max rounds of agentic tool-initiated search per query (cost/runaway guard)
MAX_SEARCH_ROUNDS=4

# How long a login session stays valid before requiring re-login (hours)
SESSION_EXPIRY_HOURS=12

# Paths
CHROMA_DB_PATH=./data/chroma_db
UPLOAD_PATH=./data/uploads

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_RESULTS=5
